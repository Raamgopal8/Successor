{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Successor",
  "version": "0.1.1",
  "identifier": "com.successor.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Successor — Personal Productivity & Flow",
        "width": 1340,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Raamgopal8/Successor/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE1NThGNkU5MjVGMEMxRUIKUldUcndmQWw2ZlpZRmJTVGttV0FQK3F6M2F4N0F5cUtyU0swUEo1ZlBQTms5SkNISHR2ckYxWTYK"
    }
  }
}
